# GajahMada 2.0 — Optional Supabase Remote Knowledge Store Configuration
# Copy this file to .env (or set in Vercel Environment Variables) to enable persistent cloud knowledge + pgvector RAG.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:YOUR_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Required on Vercel. If unset, admin routes stay locked.
# Do not rely on /tmp/knowledge_store/admin_api.key — that disk disappears on every cold start.
GAJAHMADA_ADMIN_KEY=
# Optional operator key (memory write, not full admin).
GAJAHMADA_OPERATOR_KEY=
# Production blocks private/loopback peers. Set to 1 only for local multi-node tests.
GAJAHMADA_ALLOW_LOCAL_PEERS=0

# ─── GNNM Hybrid Knowledge Architecture Feature Flags ────────────────────────
GM_HYBRID_KNOWLEDGE=true
GM_EXTERNAL_RETRIEVAL=true
GM_SEMANTIC_EMBEDDING=false
GM_HASH_EMBEDDING_FALLBACK=true
GM_KNOWLEDGE_TRAINING=false
GM_KNOWLEDGE_VERIFICATION_REQUIRED=true
GM_KNOWLEDGE_MAX_RESULTS=5
GM_KNOWLEDGE_MAX_CONTEXT_TOKENS=1024
GM_KNOWLEDGE_ENABLE_BM25=true
GM_KNOWLEDGE_ENABLE_VECTOR_SEARCH=true
GM_KNOWLEDGE_ENABLE_GRAPH_SEARCH=true
GM_KNOWLEDGE_ENABLE_DISTRIBUTED_SOURCES=false
