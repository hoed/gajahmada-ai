{
  "version": 2,
  "builds": [
    {
      "src": "interface/html/sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "interface/html/robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "interface/html/**",
          "google911ef45bbcb1db67.html",
          "config.yaml",
          "configs/bumblecore_300m.yaml",
          "gajahmada_ai/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/_vercel/(.*)",
      "dest": "/_vercel/$1"
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600",
        "X-Robots-Tag": "all"
      },
      "dest": "/interface/html/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      },
      "dest": "/interface/html/robots.txt"
    },
    {
      "src": "/google911ef45bbcb1db67.html",
      "dest": "main.py"
    },
    {
      "src": "/manifest.json",
      "dest": "main.py"
    },
    {
      "src": "/health",
      "dest": "main.py"
    },
    {
      "src": "/node/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ai/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/knowledge/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/security/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ui/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ui",
      "dest": "main.py"
    },
    {
      "src": "/((?!_vercel).*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
