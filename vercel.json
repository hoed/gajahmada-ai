{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "interface/html/**",
          "google911ef45bbcb1db67.html",
          "config.yaml",
          "gajahmada_ai/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/_vercel/(.*)",
      "dest": "/_vercel/$1"
    },
    {
      "src": "/google911ef45bbcb1db67.html",
      "dest": "main.py"
    },
    {
      "src": "/robots.txt",
      "dest": "main.py"
    },
    {
      "src": "/sitemap.xml",
      "dest": "main.py"
    },
    {
      "src": "/manifest.json",
      "dest": "main.py"
    },
    {
      "src": "/health",
      "dest": "main.py"
    },
    {
      "src": "/node/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ai/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/knowledge/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/security/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ui/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ui",
      "dest": "main.py"
    },
    {
      "src": "/((?!_vercel).*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
